# Generated by tools/build.vbs - regenerate with:
#   cscript //nologo tools\build.vbs build
#   cscript //nologo tools\build.vbs test
build/

# Excel lock/backup files
~$*
*.tmp

# Harness leftovers in case a run is interrupted
_template_staging.xlsx
_harness.flag
_timeout.txt
_export_staging/

# The published draft / pre-release and their checklist are rebuilt by the
# harness from the sources - git keeps the sources.
release/

# Safety copies of the template (backups\template) and the workbook backups
backups/

# Only the root README.md goes to the repository. Every other .md stays on the machine:
# the working documents (PROJECT_CONCEPT.md, TODO.md, DRAFT_CHECKLIST.md, QA_AUDIT.md),
# the notes next to the vendored library and the README of the sim lane.
*.md
!/README.md
